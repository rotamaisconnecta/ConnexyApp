# As duas configurações públicas usadas no browser e no SSR.
# Defina os valores reais em .env.local (ignorado) ou no ambiente do Lovable.
VITE_APP_SUPABASE_URL=
VITE_APP_SUPABASE_PUBLISHABLE_KEY=

# SSR/servidor. Use os mesmos valores públicos do projeto Supabase.
# O código também aceita VITE_APP_* como fallback no servidor.
APP_SUPABASE_URL=
APP_SUPABASE_PUBLISHABLE_KEY=

# Somente operador confiável para scripts administrativos locais; nunca use VITE_.
# APP_SUPABASE_SERVICE_ROLE_KEY=

# Demo local: só ativa com `vite dev` + esta flag. Preview/build/produção
# permanecem inativos mesmo se a flag estiver presente.
# VITE_CONNEXY_DEMO=true

# Gemini (somente servidor — NÃO use prefixo VITE_).
# Crie a chave em https://aistudio.google.com/apikey e coloque em .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
